# Server
NODE_ENV=development
PORT=4000

# Postgres (docker-compose)
POSTGRES_USER=campaign
POSTGRES_PASSWORD=change_me
POSTGRES_DB=campaign_one
POSTGRES_PORT=5433

# Prisma
DATABASE_URL=postgresql://campaign:change_me@localhost:5433/campaign_one?schema=public

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# All uploads go under this folder so they don't mix with other projects on the account
CLOUDINARY_FOLDER=campaign-one

# AI (leave empty to use demo mode)
# OpenAI: speech-to-text, campaign drafting, creative feedback, image generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Demo lifecycle speed (seconds per timed step) and how often the scheduler checks
DEMO_STEP_SEC=60
SCHEDULER_INTERVAL_SEC=15
